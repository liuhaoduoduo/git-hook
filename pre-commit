#!/usr/bin/env python3

"""
Git pre-commit 钩子脚本（Python 3 版本）

功能：在执行 commit 前自动执行编译操作

使用：
  作为 .git/hooks/pre-commit 钩子自动调用

注意：编译失败会阻止 commit 操作
"""

import subprocess
import sys
from pathlib import Path

from git_utils import get_git_dir, log_error, log_warning


def main() -> int:
    git_dir = get_git_dir()
    if not git_dir:
        log_error("Error: Could not determine git directory")
        return 1
    build_script = Path(git_dir) / "hooks" / "build-on-hook.py"
    if not build_script.exists():
        log_warning(f"Warning: Build script not found at {build_script}")
        return 0
    try:
        result = subprocess.run([
            "python3", str(build_script), "pre-commit"
        ], check=True)
        return result.returncode
    except subprocess.CalledProcessError as e:
        log_error(f"Error: Build failed, aborting commit. (exit code: {e.returncode})")
        return e.returncode
    except Exception as e:
        log_error(f"Error: Failed to execute build script: {e}")
        return 1

if __name__ == "__main__":
    sys.exit(main())
