#!/usr/bin/env python3

"""
Git pre-push 钩子脚本（Python 3 版本）

功能：
  1. 校验目标分支是否允许推送
  2. 校验是否允许删除远程分支

规则：
  - 从 .git/hooks/branch-protection.conf 读取配置
  - [push-forbidden]: 禁止推送的分支列表（为空时拒绝所有推送）
  - [delete-protected]: 禁止删除的分支列表（为空时保护所有分支）
"""

import sys
from pathlib import Path
from typing import Set

from git_utils import (
    get_git_dir,
    load_protected_branches,
    log_error,
    log_info,
    log_success,
    log_warning,
)


def parse_push_refs() -> tuple[list[str], list[str]]:
    """
    从 pre-push 的 stdin 中解析推送和删除操作

    返回：
        (push_branches, delete_branches) - 推送的分支列表和删除的分支列表
    """
    push_branches: list[str] = []
    delete_branches: list[str] = []

    data = sys.stdin.read()
    if not data:
        return push_branches, delete_branches

    for line in data.splitlines():
        parts = line.strip().split()
        if len(parts) != 4:
            continue

        _, local_sha, remote_ref, _ = parts

        # 提取分支名
        if remote_ref.startswith('refs/heads/'):
            branch_name = remote_ref[len('refs/heads/'):]

            # 检查是否为删除操作（local_sha 为全 0）
            if local_sha == '0' * 40:
                delete_branches.append(branch_name)
            else:
                push_branches.append(branch_name)

    return push_branches, delete_branches


def check_branch_protection(
    branches: list[str],
    protected_set: Set[str],
    config_file: Path,
    operation_type: str = "push"
) -> bool:
    """
    检查分支操作是否被允许（统一处理 push 和 delete）

    Args:
      branches: 要检查的分支列表
      protected_set: 受保护/禁止的分支集合
      config_file: 配置文件路径
      operation_type: "push" (禁止推送) 或 "delete" (禁止删除)

    返回：True 表示通过检查，False 表示被拦截
    """
    if not branches:
        return True

    # 检查配置文件和分支集合
    if not config_file.exists() or not protected_set:
        joined = ", ".join(sorted(set(branches)))
        if operation_type == "push":
            log_error("push 已被拒绝：禁推分支配置缺失或为空")
            log_warning(f"请在 {config_file} 的配置中设置禁推分支列表")
        else:  # delete
            log_error(f"删除分支已被拒绝：'{joined}'")
            log_warning(f"提示：当前保护所有分支（配置为空或不存在）")
            log_warning(f"如需允许删除，请在 {config_file} 中配置可删除的分支列表")
        return False

    # 检查是否有受保护/禁止的分支
    blocked = [branch for branch in branches if branch in protected_set]
    if blocked:
        joined = ", ".join(sorted(set(blocked)))
        if operation_type == "push":
            log_error(f"push 已被拒绝：检测到禁止推送分支 -> {joined}")
        else:  # delete
            log_error(f"删除分支已被拒绝：不允许删除受保护的分支 '{joined}'")
            log_warning(f"受保护的分支列表：{', '.join(sorted(protected_set))}")
        return False

    return True


def main() -> int:
    git_dir = get_git_dir()
    if not git_dir:
        log_error("无法获取 Git 目录，已拒绝 push")
        return 1

    # 分支保护检查，被列为保护的分支不能推送，不能删除
    config_file = Path(git_dir) / "hooks" / "branch-protection.conf"
    protected_branches = load_protected_branches(config_file)

    # 解析推送操作
    push_branches, delete_branches = parse_push_refs()

    # 检查推送分支限制
    if push_branches:
        if not check_branch_protection(push_branches, protected_branches, config_file, "push"):
            return 1
        log_success("推送分支校验通过")

    # 检查删除分支保护
    if delete_branches:
        if not check_branch_protection(delete_branches, protected_branches, config_file, "delete"):
            return 1
        log_success("删除分支校验通过")

    if not push_branches and not delete_branches:
        log_info("无需检查（无推送或删除操作）")

    return 0


if __name__ == "__main__":
    sys.exit(main())
