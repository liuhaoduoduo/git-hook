#!/usr/bin/env python3

"""
Git pre-rebase 钩子脚本（Python 3 版本）

功能：
  检查 rebase 是否被 protected 规则允许
  - 若当前分支在保护列表中，仅允许 rebase 到自身分支（origin/<branch> 或 <branch>）
  - 其他分支的 rebase 会被拒绝

使用：
  作为 .git/hooks/pre-rebase 钩子自动调用
  参数：
    $1: upstream（要 rebase 到的目标分支）
    $2: branch（被 rebase 的分支，可选，仅在 rebase 其他分支时提供）

注意：
  - 若 rebase 被拒绝，会返回非零状态码（阻止 rebase）
  - 编译检查在 pre-push 中统一进行
"""

import sys

from git_utils import (
    get_current_branch,
    log_warning,
    validate_branch_operation,
)


def main() -> int:
    """主函数：检查 rebase 保护规则"""

    # 获取 pre-rebase 的参数
    # $1: upstream (要 rebase 到的分支/commit)
    # $2: branch (被 rebase 的分支，仅在 rebase 其他分支时提供)
    upstream = sys.argv[1] if len(sys.argv) > 1 else ""
    rebasing_branch = sys.argv[2] if len(sys.argv) > 2 else None

    if not upstream:
        log_warning("警告：无法获取 upstream 信息")
        return 0

    # 获取当前分支
    if rebasing_branch:
        current_branch = rebasing_branch
    else:
        current_branch = get_current_branch()

    if not current_branch:
        log_warning("警告：无法获取当前分支名")
        return 0

    # 验证 rebase 操作是否被允许
    if not validate_branch_operation(current_branch, upstream, "rebase"):
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
