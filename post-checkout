#!/usr/bin/env python3

"""
Git post-checkout 钩子脚本
功能：在切换分支后自动执行 git pull 拉取更新
"""

import subprocess
import sys

from git_utils import (
    TIMEOUT_DEFAULT,
    check_remote_tracking_branch,
    get_current_branch,
    log_error,
    log_info,
    log_warning,
    set_auto_pull_flag,
)


def run_git_pull():
    """在分支切换后执行 git pull --no-rebase 命令"""

    try:
        # 获取当前分支名称
        current_branch = get_current_branch()

        # 检查获取分支名称是否成功
        if not current_branch:
            log_error("获取当前分支名称失败")
            return

        # 输出当前分支名称
        log_info(f"当前分支: {current_branch}")

        # 检查远程追踪分支是否存在
        if not check_remote_tracking_branch(current_branch):
            log_warning(f"分支 '{current_branch}' 没有对应的远程追踪分支，跳过拉取")
            return

        # 设置自动拉取标记，防止 post-merge hook 在拉取后再次询问是否 push
        set_auto_pull_flag()

        # 执行 git pull --no-rebase 命令（不使用 rebase 方式）
        log_info(f"从 origin/{current_branch} 拉取更新...")
        pull_result = subprocess.run(
            ['git', 'pull', '--no-rebase'],
            timeout=TIMEOUT_DEFAULT,
            check=False
        )

        # 根据 git pull 的返回状态处理
        if pull_result.returncode == 0:
            log_info("拉取成功")
        elif pull_result.returncode == 1:
            log_warning("拉取完成但存在冲突，请手动解决冲突")
        else:
            log_error(f"拉取失败，退出码: {pull_result.returncode}")

    except subprocess.TimeoutExpired:
        log_error("Git 拉取超时")
    except Exception as e:
        log_error(f"拉取过程中出错: {e}")

if __name__ == '__main__':
    # 执行拉取操作
    run_git_pull()
    # 不管是否失败都不阻止分支切换
    sys.exit(0)
